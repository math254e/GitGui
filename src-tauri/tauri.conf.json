{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitGui",
  "version": "0.1.0",
  "identifier": "com.mathi.gitgui",
  "build": {
    "beforeDevCommand": "npm run tauri:prepare-sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run tauri:prepare-sidecar -- --release && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "GitGui",
        "width": 1200,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/gitgui-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
