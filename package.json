{
  "name": "gitgui",
  "version": "0.1.0",
  "description": "A modern Git GUI built on Tauri, SvelteKit, Rust, and the system Git executable.",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "ui:dev": "vite dev",
    "build": "vite build",
    "server:dev": "cargo run -p gitgui-server -- --port 3774 --repository .",
    "web:serve": "npm run build && cargo run -p gitgui-server -- --bind 127.0.0.1 --port 3774 --repository .",
    "protocol:generate": "cargo run -p gitgui-protocol --bin generate-typescript --quiet",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "tauri:prepare-sidecar": "node scripts/prepare-gitgui-server.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "license": "MIT",
  "dependencies": {
    "@lucide/svelte": "^1.17.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "monaco-editor": "^0.55.1",
    "svelte-sonner": "^1.2.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
